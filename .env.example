# ---------- obrigatórias ----------
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---------- IA: modo econômico por padrão ----------
# Gemini é o provedor principal recomendado para o Parfum Atlas.
# Crie a chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo econômico. Você pode trocar por outro modelo Gemini compatível.
GEMINI_MODEL=gemini-flash-lite-latest
# Modelo usado especificamente na pesquisa econômica de perfumes semelhantes.
GEMINI_MODEL_FREE=gemini-flash-lite-latest

# ---------- OpenAI: opcional / premium ----------
# Deixe AI_PREMIUM_ENABLED=false para impedir que a pesquisa pesada de semelhantes
# use OpenAI mesmo que uma OPENAI_API_KEY continue cadastrada na Vercel.
AI_PREMIUM_ENABLED=false
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5-mini
# OPENAI_MODEL_PESQUISA=gpt-5-mini

# IMPORTANTE: enquanto OPENAI_API_KEY estiver preenchida, partes legadas do Atlas
# (ficha/foto/sommelier) ainda podem escolher OpenAI pelo roteador existente.
# Para operar no modo econômico imediatamente, remova OPENAI_API_KEY da Vercel
# ou deixe a variável vazia. A busca de semelhantes já ignora a OpenAI por padrão.

# ---------- avisos no celular ----------
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase: Project Settings > API > service_role (nunca exponha no navegador)
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer texto longo e aleatório. A Vercel manda ele no aviso diário.
CRON_SECRET=

# ---------- Alexa (opcional) ----------
# ID da skill (amzn1.ask.skill....) e o seu id de usuário no Supabase (Authentication > Users)
ALEXA_SKILL_ID=
ATLAS_USER_ID=
