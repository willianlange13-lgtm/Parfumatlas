# ---------- obrigatórias ----------
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Gemini (IA da ficha, da foto e do sommelier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ---------- avisos no celular ----------
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase: Project Settings > API > service_role (nunca exponha no navegador)
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer texto longo e aleatório. A Vercel manda ele no aviso diário.
CRON_SECRET=

# ---------- Alexa (opcional) ----------
# ID da skill (amzn1.ask.skill....) e o seu id de usuário no Supabase (Authentication > Users)
ALEXA_SKILL_ID=
ATLAS_USER_ID=
