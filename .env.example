# ---------- obrigatórias ----------
# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ---------- IA: modo econômico por padrão ----------
# Gemini é o provedor principal recomendado para o Parfum Atlas.
# Crie a chave em: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Modelo econômico. Você pode trocar por outro modelo Gemini compatível.
GEMINI_MODEL=gemini-flash-lite-latest
# Modelo usado especificamente na pesquisa econômica de perfumes semelhantes.
GEMINI_MODEL_FREE=gemini-flash-lite-latest

# ---------- OpenAI: opcional / compatibilidade ----------
# Se GEMINI_API_KEY existir, o Atlas usa Gemini por padrão mesmo que esta chave também exista.
OPENAI_API_KEY=
# Para forçar OpenAI como provedor principal:
# AI_PROVIDER=openai
# OPENAI_MODEL=gpt-5-mini
# OPENAI_MODEL_PESQUISA=gpt-5-mini

# ---------- pesquisa premium opcional ----------
# false = nunca inicia a pesquisa pesada de semelhantes na OpenAI.
# true = permite fallback premium em background quando necessário.
AI_PREMIUM_ENABLED=false

# ---------- avisos no celular ----------
# Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Supabase: Project Settings > API > service_role (nunca exponha no navegador)
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer texto longo e aleatório. A Vercel manda ele no aviso diário.
CRON_SECRET=

# ---------- Alexa (opcional) ----------
# ID da skill (amzn1.ask.skill....) e o seu id de usuário no Supabase (Authentication > Users)
ALEXA_SKILL_ID=
ATLAS_USER_ID=
